{
  "name": "flashdrop-p2p",
  "version": "0.1.0",
  "private": true,
  "description": "尺素：一次扫码，通过 WebRTC 在局域网内端到端直传文件。",
  "license": "MIT",
  "keywords": ["webrtc", "p2p", "file-transfer", "local-network", "privacy"],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names WEBRTC,WEB \"node scripts/signaling.mjs\" \"WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 0.0.0.0\"",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "serve": "concurrently --kill-others --names WEBRTC,WEB \"node scripts/signaling.mjs\" \"vinext start --hostname 0.0.0.0\"",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "lucide-react": "^1.34.0",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
